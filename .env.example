# LLM provider ('xai' | 'gemini' | 'openrouter' | 'none')
# 'none' disables LLM and returns evidence-only responses.
LLM_PROVIDER=xai

# --- xAI (Grok) ---
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- OpenRouter (OpenAI-compatible proxy; supports Llama, Mistral, Claude, etc.) ---
# Get your key at https://openrouter.ai/keys
# Browse models at https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# APIs
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
DAILYMED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2

# Local data
SQLITE_DB_PATH=data/ddi.db
CHROMA_PERSIST_DIR=data/chroma_store

# Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# RAG
RAG_CHUNK_SIZE_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=40
RAG_DEFAULT_TOP_K=5

# LLM
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_EVIDENCE_ITEMS=8

# Backend hardening
DEBUG=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60.0
MAX_DRUG_NAME_LENGTH=200
MAX_DRUGS_PER_MULTI_REQUEST=10
MAX_REQUEST_BODY_BYTES=20000

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
FRONTEND_ORIGIN=http://localhost:5173
